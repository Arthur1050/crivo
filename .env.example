# Copie para .env e preencha os valores reais.

# Connection string do Postgres (Neon ou local)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Connection string de um banco DESCARTÁVEL para a suíte de testes (branch
# de teste do Neon, ou um Postgres local) - nunca aponte para o mesmo banco
# de DATABASE_URL. `npx vitest run` reseeda o banco várias vezes (inclusive
# gerando API keys novas); sem isso, testes rodados por engano contra
# produção/demo invalidam chaves de consumidores reais (ex.: n8n).
TEST_DATABASE_URL="postgresql://user:password@host:5432/dbname_test?sslmode=require"
