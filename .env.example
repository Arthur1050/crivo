# Copie para .env e preencha os valores reais.

# Connection string do Postgres (Neon ou local)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Connection string de um banco DESCARTÁVEL para a suíte de testes (branch
# de teste do Neon, ou um Postgres local) - nunca aponte para o mesmo banco
# de DATABASE_URL. `npx vitest run` reseeda o banco várias vezes (inclusive
# gerando API keys novas); sem isso, testes rodados por engano contra
# produção/demo invalidam chaves de consumidores reais (ex.: n8n).
TEST_DATABASE_URL="postgresql://user:password@host:5432/dbname_test?sslmode=require"

# Segredo que assina o cookie de sessao do better-auth (lote-8 - AUTH-01).
# Sem ele a biblioteca cai num valor de desenvolvimento e LANCA em producao.
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-bytes"

# URL base da aplicacao, usada pelo better-auth para montar callbacks e links
# de e-mail (convite, redefinicao de senha). Em producao, o dominio real.
BETTER_AUTH_URL="http://localhost:3000"

# Chave da API do Resend, usada para enviar convite e redefinicao de senha
# (lote-8 - USER-01/AUTH-02). Sem ela o produto continua subindo: o envio
# falha como retorno e o convite fica pendente e reenviavel.
RESEND_API_KEY=""

# Remetente dos e-mails. Precisa ser de um dominio verificado no Resend.
RESEND_FROM="Crivo <onboarding@resend.dev>"
